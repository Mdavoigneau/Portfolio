{
  "name": "davoigneau-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One-page portfolio — built in React 18 + TypeScript (strict) + Vite + Tailwind v4 + Radix.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
